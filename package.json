{
  "name": "local-ocr-gui",
  "private": true,
  "version": "0.2.0",
  "description": "Offline OCR desktop app built with Electron, React, and PP-OCRv5",
  "main": "electron/main.cjs",
  "author": "iwen-conf",
  "scripts": {
    "prepare:ocr-models": "node ./scripts/prepare-paddle-models.mjs",
    "postinstall": "npm --prefix frontend install && node ./scripts/prepare-paddle-models.mjs",
    "dev:renderer": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "node ./scripts/prepare-paddle-models.mjs && npm --prefix frontend run build",
    "build": "node ./scripts/prepare-paddle-models.mjs && npm --prefix frontend run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "node ./scripts/prepare-paddle-models.mjs && npm --prefix frontend run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never",
    "dist:mac": "node ./scripts/prepare-paddle-models.mjs && npm --prefix frontend run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never --mac dmg --arm64",
    "dist:win": "node ./scripts/prepare-paddle-models.mjs && npm --prefix frontend run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never --win nsis portable --x64",
    "dist:win:dir": "node ./scripts/prepare-paddle-models.mjs && npm --prefix frontend run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never --win dir --x64",
    "dist:linux": "node ./scripts/prepare-paddle-models.mjs && npm --prefix frontend run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never --linux AppImage --x64",
    "verify:runtime:mac": "node ./scripts/verify-packaged-runtime.mjs mac",
    "verify:runtime:win": "node ./scripts/verify-packaged-runtime.mjs win",
    "verify:runtime:linux": "node ./scripts/verify-packaged-runtime.mjs linux",
    "verify:runtime:all": "npm run verify:runtime:mac && npm run verify:runtime:win && npm run verify:runtime:linux",
    "write:release-draft": "node ./scripts/write-release-draft.mjs",
    "publish:release": "node ./scripts/publish-release.mjs",
    "publish:release:github": "node ./scripts/publish-release.mjs --provider github",
    "publish:release:gitea": "node ./scripts/publish-release.mjs --provider gitea",
    "package:delivery": "./scripts/package-delivery-bundle.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.iwenconf.localocrgui",
    "productName": "Local OCR Desk",
    "afterPack": "scripts/inject-platform-canvas-runtime.cjs",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/ocr-models",
        "to": "ocr-models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "electron/resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}"
    },
    "win": {
      "icon": "electron/resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "onnxruntime-node": "^1.24.3",
    "ppu-ocv": "^2.0.0",
    "ppu-paddle-ocr": "^4.1.1",
    "word-list": "^4.1.0"
  }
}
